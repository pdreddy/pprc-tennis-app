# Leave empty to run in mock mode (no AI calls, realistic placeholder output).
REPLICATE_API_TOKEN=

# Models are configurable. Defaults were picked from Replicate's official collection (Oct 2026).
# Official models stay warm and use owner/name; community models need owner/name:version.
REPLICATE_TEXT_MODEL=google/gemini-3.5-flash
REPLICATE_VIDEO_MODEL=google/gemini-3.5-flash
REPLICATE_IMAGE_MODEL=prunaai/p-image
