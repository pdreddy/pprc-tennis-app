# Local mode is default. Use a demo project only with the emulators.
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-pprc-events
VITE_FIREBASE_API_KEY=demo-pprc-events
VITE_FIREBASE_AUTH_DOMAIN=demo-pprc-events.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-pprc-events.appspot.com
VITE_FIREBASE_APP_ID=1:123:web:demo
# Production Firebase public configuration (never a service-account key).
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Set api only after the fresh club is seeded and FastAPI is deployed.
VITE_DATA_PROVIDER=firebase
VITE_API_BASE_URL=http://localhost:8000
VITE_PPRC_CLUB_ID=
VITE_PPRC_CLUB_SLUG=pprc
