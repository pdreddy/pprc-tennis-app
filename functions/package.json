{
  "name": "@pprc/functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "deploy/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node ../scripts/events/prepare-functions.mjs && tsup && node ../scripts/events/package-functions.mjs && node ../scripts/events/install-functions.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@pprc/shared": "workspace:*",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "stripe": "^18.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.9.1",
    "tsx": "^4.20.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
