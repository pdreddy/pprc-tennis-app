# docker-compose supplies this value automatically. Use a Supabase pooler URL in hosted environments.
DATABASE_URL=postgresql+asyncpg://pprc:pprc@localhost:5432/pprc
# postgres:// and postgresql:// URLs (and ?sslmode=require) from Render, Neon, Supabase, Railway work as-is.
# Behind a Supabase/PgBouncer transaction pooler (port 6543) also set PPRC_DB_POOLER=true.
PPRC_DB_POOLER=false
# Apply backend/sql migrations when the container starts (deployed environments).
PPRC_RUN_MIGRATIONS=false
# Trust X-Forwarded-For from the host's reverse proxy (rate limiting by client address).
PPRC_TRUST_PROXY=false
PPRC_CORS_ORIGINS=http://localhost:5173
# Blank = create tables at startup in development only. Set false when the schema is applied from backend/sql.
PPRC_BOOTSTRAP_SCHEMA=
# development permits X-PPRC-User for local demo data only. Set production in deployed environments.
PPRC_ENVIRONMENT=development
# Pin the bearer-token verifier in deployed environments: clerk | firebase (auto = Clerk if CLERK_SECRET_KEY is set, else Firebase).
PPRC_AUTH_PROVIDER=auto
CLERK_SECRET_KEY=
# Set this to your Firebase project ID before FastAPI accepts Firebase bearer tokens.
FIREBASE_PROJECT_ID=
# Server-only Stripe configuration. Keep these out of VITE_* frontend variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PPRC_APP_ORIGIN=http://localhost:5173
